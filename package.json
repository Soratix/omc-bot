{
  "name": "omc-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot Discord de l'Ocean Medical Center",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "croner": "11.0.1",
    "discord.js": "14.28.1",
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
