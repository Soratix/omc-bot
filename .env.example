# ── Discord ───────────────────────────────────────────────────────
# Token du bot (Developer Portal > Bot > Reset Token). Ne jamais le partager ni le commiter.
DISCORD_TOKEN=
# ID du serveur Discord de l'OMC (mode développeur activé : clic droit sur le serveur > Copier l'identifiant)
GUILD_ID=

# ── Base de données ───────────────────────────────────────────────
POSTGRES_USER=omc
# Mot de passe long et aléatoire, ex. : openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=omc_bot

# ── Absences ──────────────────────────────────────────────────────
# Heure de la tâche quotidienne (heure de Paris)
ABSENCE_CHECK_HOUR=9
# Jours sans réponse au rappel avant le statut « Retour non confirmé »
ABSENCE_CONFIRM_DAYS=2

# ── Sauvegardes ───────────────────────────────────────────────────
BACKUP_HOUR=4
BACKUP_KEEP_DAYS=7
